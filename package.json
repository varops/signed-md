{
  "name": "signed-md-workspace",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "verify": "node packages/verify/bin/signed-md.js verify",
    "start": "node apps/server/src/main.ts",
    "bundle": "pnpm --filter @signed-md/server bundle",
    "demo": "node apps/server/src/demo.ts",
    "cli": "node apps/server/src/cli.ts",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "AGPL-3.0-only"
}
