{
  "name": "signed-md",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "verify": "node packages/verify/bin/signed-md.js verify",
    "start": "node apps/server/src/main.ts",
    "demo": "node apps/server/src/demo.ts",
    "cli": "node apps/server/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
